{
  "name": "plumary",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
