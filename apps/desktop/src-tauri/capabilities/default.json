{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Panel and settings windows",
  "windows": [
    "panel",
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "updater:default",
    "process:default"
  ]
}
